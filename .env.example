# =====================================================================
#  Environment: development | production
#  production = strict mode (requires JWT_SECRET, secure cookies, no API docs by default)
# =====================================================================
APP_ENV=development

# ---- Groq (all models on the same key, OpenAI-compatible API) ----
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
GROQ_REASONING_EFFORT=low
GROQ_DISCOVER_MODELS=true

# ---- Optional secondary provider (any OpenAI-compatible API) ----
SECONDARY_API_KEY=
SECONDARY_BASE_URL=https://api.openai.com/v1
SECONDARY_MODEL=gpt-4o-mini

# ---- Auth / session security ----
# REQUIRED in production: long random string (e.g. python -c "import secrets;print(secrets.token_urlsafe(48))")
# In development, if empty, a random secret is generated once and stored in ./data/.jwt_secret
JWT_SECRET=
JWT_EXP_HOURS=8
# Session cookie only over HTTPS (auto true in production)
COOKIE_SECURE=
# Self-registration on/off, and optional invite code required to register
ALLOW_REGISTRATION=true
REGISTRATION_INVITE_CODE=
# Account lockout: N failed logins for an email -> locked for M minutes
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_PER_IP_5MIN=30
REGISTER_RATE_PER_IP_HOUR=10
# Set to 1 when running behind ONE reverse proxy (Render, Nginx) so the real client IP is used
TRUST_PROXY=0
# Comma separated allowed cross-origin frontends. Empty = same-origin only (recommended)
CORS_ORIGINS=
# Swagger UI at /api/docs (loads from CDN). Default: on in development, off in production
ENABLE_API_DOCS=

# ---- Abuse / cost limits (per user) ----
CHAT_RATE_PER_MIN=10
CHAT_RATE_PER_DAY=300
DAILY_TOKEN_BUDGET=300000
UPLOAD_RATE_PER_HOUR=60
MAX_DOCS_PER_USER=200
MAX_STORAGE_MB_PER_USER=300

# ---- Upload / parsing limits ----
DATABASE_PATH=./data/eip.sqlite3
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=300
MAX_EXTRACT_CHARS=2000000
MAX_CHUNKS_PER_DOC=3000
EXTRACT_TIMEOUT_SEC=60
# Parse PDFs in an isolated child process with a hard timeout (recommended)
PDF_SANDBOX=true
# Reject PDFs containing JavaScript or Launch actions
REJECT_ACTIVE_PDF=true

# ---- Prompt-injection defence ----
# What to do with document text that looks like an injected instruction: redact | warn | exclude
INJECTION_ACTION=redact
# Optional ML classifier on Groq (preview model, check availability for your key)
PROMPT_GUARD_ENABLED=false
PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
PROMPT_GUARD_THRESHOLD=0.8
PROMPT_GUARD_MAX_CHUNKS=150
# Mask emails / phone / Aadhaar / PAN / card numbers before text is sent to the LLM
REDACT_PII=false

# ---- Retrieval ----
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=./data/models
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=6
MIN_RELEVANCE=0.25
ENABLE_QUERY_REWRITE=true

# ---- Agent ----
AGENT_MAX_STEPS=6
AGENT_TOOL_TIMEOUT_SEC=90
